{
    email {$TLS_EMAIL}
    log {
        format filter {
            # Runtime proxy errors can include the full URI and request headers.
            request delete
        }
    }
}
{$AYO_DOMAIN} {
    encode zstd gzip
    @nearby_reports path /api/winter/reports/nearby
    @other_requests not path /api/winter/reports/nearby
    request_body @nearby_reports {
        max_size 32KiB
    }
    request_body @other_requests {
        max_size 8KB
    }
    reverse_proxy app:8000 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    # Access logging is disabled here; Gunicorn logs redacted paths/status/latency.
    # Never enable raw URI logging without excluding GPS query strings.
}
