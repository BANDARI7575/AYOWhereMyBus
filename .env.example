# Export these using your deployment's secret/environment settings.
MODERATOR_TOKEN=replace-with-a-long-random-secret
GTFS_DIR=google_transit
SCHEDULE_DB=instance/schedule.sqlite
COMMUNITY_DB=instance/community.sqlite
TRIP_UPDATES_URL=https://realtime.ridemcts.com/gtfsrt/trips
ALERTS_URL=https://realtime.ridemcts.com/gtfsrt/alerts

# Production only: require real secrets and an exact approved host list.
AYO_ENV=production
ALLOWED_HOSTS=ayo.example.org
PRIVACY_KEY=replace-with-a-long-random-secret
# Set to 1 only when ALL incoming traffic comes through one trusted ingress
# that replaces X-Forwarded-For and X-Forwarded-Proto. Keep application port private.
PROXY_HOPS=0
PORT=8000
# Full release: no reduced-feature public mode. Named secrets are supplied by the host.
# MODERATOR_TOKENS={"primary-reviewer":"GENERATE_A_RANDOM_32_BYTE_SECRET"}
SUPPORT_EMAIL=replace-with-real-operator-email
RETENTION_APPROVED=0
# Generate keys locally into a protected directory, then import into secret manager.
VAPID_PRIVATE_KEY=/run/secrets/ayo/vapid-private.pem
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_SUBJECT=mailto:replace-with-real-operator-email
PUSH_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Separate backup key; generate with cryptography.fernet.Fernet.generate_key().
BACKUP_ENCRYPTION_KEY=replace-with-separate-fernet-key
BACKUP_RETENTION_DAYS=30

# Immutable proxy image pin; still validate Docker/Linux execution on the chosen host.
CADDY_IMAGE=caddy:2-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9
AYO_DOMAIN=replace-with-approved-domain
TLS_EMAIL=replace-with-real-operator-email
